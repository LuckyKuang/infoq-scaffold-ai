*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Frontend and tooling text.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.vue text eol=lf
*.json text eol=lf
