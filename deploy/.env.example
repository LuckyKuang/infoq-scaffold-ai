# =============================================================================
# InfoQ-Scaffold-AI container environment
# =============================================================================
# Copy this file before a local Compose run:
#   cp deploy/.env.example deploy/docker/.env
#   chmod 600 deploy/docker/.env
#
# 此模板中的示例值会被生产预检拒绝，不能直接用于生产启动。
# 生产基线为 Linux Docker；受控文件权限 0600，且不提交、不打印。
# 完整步骤见 deploy/PRODUCTION.md。development 必须显式选择，绝不自动降级。
#
# Do not commit deploy/docker/.env or deploy/.env.
# =============================================================================

# Public origin used by MinIO console/OSS redirects and printed URLs.
INFOQ_DEPLOY_MODE=production
INFOQ_CONFIG_SOURCE=controlled-file
INFOQ_PUBLIC_BASE_URL=https://app.example.com
# S3 签名绑定 Host/path；必须使用独立主机根路径，与应用协议/端口一致。
INFOQ_OSS_PUBLIC_ORIGIN=https://oss.example.com
# 单张叶子证书及中间链需覆盖上面两个主机；私钥必须 0600。
INFOQ_TLS_CERT_FILE=/etc/infoq-scaffold-ai/tls/fullchain.pem
INFOQ_TLS_KEY_FILE=/etc/infoq-scaffold-ai/tls/privkey.pem
# 与 INFOQ_ENV_FILE 使用同一个受控文件，构建通过 BuildKit secret 读取。
INFOQ_PRODUCTION_CONFIG_FILE=/etc/infoq-scaffold-ai/deploy.env
INFOQ_INTERNAL_BIND_HOST=127.0.0.1

# Host directory for MySQL, Redis, MinIO, Nginx, and server files.
# WSL2 / Linux default: /infoq
# macOS Colima default: $HOME/infoq
INFOQ_DEPLOY_ROOT=/infoq

# vue | react | all
INFOQ_FRONTEND_TARGET=all

# Source archive ref used by install.sh (e.g. v3.0.0); not a Compose image override.
INFOQ_VERSION=3.0.0

# MySQL
MYSQL_ROOT_PASSWORD=change-me-mysql-root
INFOQ_DB_USERNAME=infoq_app
INFOQ_DB_PASSWORD=change-me-db-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# MinIO
MINIO_ROOT_USER=infoqminio
MINIO_ROOT_PASSWORD=change-me-minio-password
INFOQ_OSS_BUCKET=infoq
# 若 MinIO 镜像 Config.User 为空，必须审阅 entrypoint 后显式提供实际业务账户。
INFOQ_MINIO_IMAGE_USER=

# Backend token secret. Use a long random value in any shared environment.
SECURITY_TOKEN_SECRET=change-me-token-secret

# 两组独立且至少 2048 位 RSA，仅支持单行 Base64 DER：public SPKI/private PKCS8；不接受 PEM/多行。
# 前端公钥匹配后端请求私钥；前端私钥匹配后端响应公钥。
# 浏览器协议私钥属于公开产物，不能承担服务端秘密保护。
VITE_APP_ENCRYPT=true
VITE_APP_RSA_PUBLIC_KEY=
VITE_APP_RSA_PRIVATE_KEY=
INFOQ_API_REQUEST_PRIVATE_KEY=
INFOQ_API_RESPONSE_PUBLIC_KEY=

# Deployment batch id. install.sh generates version-timestamp-random.
DEPLOY_ID=3.0.0-local

# Used by infoq.sh to personalize the baseline administrator; not Compose fields.
# Production username: 3..30 ASCII characters; password: 16..30 characters,
# with independent strong values that satisfy the password login contract.
INFOQ_ADMIN_USERNAME=admin
INFOQ_ADMIN_PASSWORD=change-me-admin-password

# Frontend context paths when deploying the `all` gateway target.
INFOQ_VUE_CONTEXT_PATH=/vue/
INFOQ_REACT_CONTEXT_PATH=/react/

# Apple container local stack. Docker Compose ignores these keys.
# Keep this stack isolated from other Apple container projects.
APPLE_CONTAINER_BIND_HOST=127.0.0.1
APPLE_CONTAINER_HOST_PORT=19090
APPLE_CONTAINER_NETWORK_SUBNET=192.168.66.0/24
APPLE_CONTAINER_MYSQL_IMAGE=mysql:8.0.42
APPLE_CONTAINER_REDIS_IMAGE=redis:7.2.8
APPLE_CONTAINER_ADMIN_IMAGE=localhost/infoq-admin:3.0.0-apple
APPLE_CONTAINER_DEPLOY_ROOT=
